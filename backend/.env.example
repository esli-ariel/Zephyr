APP_NAME=Zephyr
APP_ENV=development
DEBUG=true

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b


FRONTEND_URL=http://localhost:4000

# Sauvegarde locale des apprenants (chemin par défaut : backend/data/zephyr.sqlite3)
PERSISTENCE_ENABLED=true
# DATABASE_PATH=/chemin/absolu/zephyr.sqlite3

# Comptes activés par défaut ; garder false uniquement pour les anciens tests/outils locaux.
AUTH_ENABLED=true
# false pour http://127.0.0.1 ; true obligatoire avec APP_ENV=production et HTTPS.
AUTH_COOKIE_SECURE=false
